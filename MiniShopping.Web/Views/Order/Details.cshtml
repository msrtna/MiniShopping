@model List<MiniShopping.Web.DTOs.OrderDtos.OrderDetailDto>

@{
    ViewData["Title"] = "Order Details";
}

<h2>Order Details</h2>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Unit Price</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice</td>
                <td>@item.TotalPrice</td>
            </tr>
        }

    </tbody>

</table>
@if (User.IsInRole("Admin"))
{
    <a asp-controller="Admin"
       asp-action="Orders"
       class="btn btn-secondary">
        Back
    </a>
}
else
{
    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
}