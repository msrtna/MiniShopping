@model MiniShopping.Web.DTOs.CategoryDtos.UpdateCategoryDto

<h2>Edit Category</h2>

<form method="post">

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>

        <input asp-for="Name"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-warning">
        Update
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>
