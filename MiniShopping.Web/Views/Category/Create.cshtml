@model MiniShopping.Web.DTOs.CategoryDtos.CreateCategoryDto

@{
    ViewData["Title"] = "Create Category";
}

<h2>Create Category</h2>

<form method="post">

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>

        <input asp-for="Name"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-success">
        Save
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</form>