@model List<MiniShopping.Web.DTOs.UserDtos.UserDto>

@{
    ViewData["Title"] = "Users";
}

<h2>Users</h2>

<table class="table table-striped table-bordered">

    <thead class="table-dark">
        <tr>
            <th>Email</th>
            <th>User Name</th>
            <th>Role</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Email</td>
                <td>@item.UserName</td>
                <td>@item.Role</td>
            </tr>
        }

    </tbody>

</table>